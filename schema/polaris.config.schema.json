{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JiaCheng2004/Polaris/schema/polaris.config.schema.json",
  "title": "Polaris configuration",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 2
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": { "$ref": "#/$defs/server" },
        "auth": { "$ref": "#/$defs/auth" },
        "store": { "$ref": "#/$defs/store" },
        "cache": { "$ref": "#/$defs/cache" },
        "control_plane": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "tools": { "$ref": "#/$defs/tools" },
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "auth": { "type": "array", "items": { "type": "string" } },
            "oauth": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "resource_uri": { "type": "string" },
                "authorization_servers": { "type": "array", "items": { "type": "string" } },
                "jwks_cache_ttl": { "type": "string" }
              }
            }
          }
        },
        "files": { "$ref": "#/$defs/files" },
        "pricing": { "$ref": "#/$defs/pricing" },
        "observability": { "$ref": "#/$defs/observability" },
        "guardrails": { "type": "object" },
        "reliability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "retry_budget_ratio": { "type": "number" },
            "shed": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "global_max_inflight": { "type": "integer" },
                "per_provider_max_inflight": { "type": "integer" }
              }
            },
            "breaker_defaults": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "error_rate": { "type": "number" },
                "min_samples": { "type": "integer" },
                "open_for": { "type": ["string", "integer"] },
                "half_open_probes": { "type": "integer" }
              }
            },
            "idempotency": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "ttl": { "type": ["string", "integer"] }
              }
            }
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/provider" }
    },
    "routing": { "$ref": "#/$defs/routing" }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)([0-9]+(ns|us|µs|ms|s|m|h))*$"
    },
    "hashedSecret": {
      "type": "string",
      "pattern": "^(|sha256:.+|\\$\\{[A-Z0-9_]+\\})$"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "read_timeout": { "$ref": "#/$defs/duration" },
        "write_timeout": { "$ref": "#/$defs/duration" },
        "shutdown_timeout": { "$ref": "#/$defs/duration" },
        "max_body_bytes": { "type": "integer", "minimum": 1 },
        "cors": { "$ref": "#/$defs/cors" }
      }
    },
    "cors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "allowed_origins": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "allowed_headers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "allowed_methods": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "exposed_headers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "allow_credentials": { "type": "boolean" },
        "max_age": { "$ref": "#/$defs/duration" }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": { "enum": ["none", "static", "external", "virtual_keys", "multi-user"] },
        "bootstrap_admin_key_hash": { "$ref": "#/$defs/hashedSecret" },
        "admin_key_hash": { "$ref": "#/$defs/hashedSecret" },
        "static_keys": { "type": "array" },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": { "const": "signed_headers" },
            "shared_secret": { "type": "string" },
            "max_clock_skew": { "$ref": "#/$defs/duration" },
            "cache_ttl": { "$ref": "#/$defs/duration" }
          }
        }
      }
    },
    "store": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driver": { "enum": ["sqlite", "postgres"] },
        "dsn": { "type": "string" },
        "max_connections": { "type": "integer", "minimum": 1 },
        "log_retention_days": { "type": "integer", "minimum": 1 },
        "log_buffer_size": { "type": "integer", "minimum": 1 },
        "log_flush_interval": { "$ref": "#/$defs/duration" }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "driver": { "enum": ["memory", "redis"] },
        "url": { "type": "string" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "local": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "implementation": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingestion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_upload_bytes": { "type": "integer", "minimum": 0 },
            "allowed_mime": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inline_max_bytes": { "type": "integer", "minimum": 0 },
            "blob_store": { "enum": ["none", "disk", "s3"] },
            "disk_path": { "type": "string" },
            "s3": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "endpoint": { "type": "string" },
                "bucket": { "type": "string" },
                "region": { "type": "string" },
                "access_key_id": { "type": "string" },
                "secret_access_key": { "type": "string" },
                "session_token": { "type": "string" },
                "use_ssl": { "type": "boolean" }
              }
            }
          }
        },
        "downloads": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token_ttl": { "$ref": "#/$defs/duration" }
          }
        },
        "ssrf": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_schemes": {
              "type": "array",
              "items": { "enum": ["http", "https"] }
            },
            "deny_hosts": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "materialization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "inline_fallback_max": { "type": "integer", "minimum": 0 }
          }
        },
        "understanding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "enum": ["disabled", "explicit", "auto_fallback"] },
            "profile": { "enum": ["fast", "balanced", "quality"] },
            "max_bytes": { "type": "integer", "minimum": 0 },
            "max_text_chars": { "type": "integer", "minimum": 0 },
            "cache_artifacts": { "type": "boolean" },
            "chunking": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "max_chars": { "type": "integer", "minimum": 0 },
                "overlap_chars": { "type": "integer", "minimum": 0 }
              }
            },
            "processors": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": { "type": "boolean" },
                  "name": { "type": "string" },
                  "backend": { "enum": ["http", "remote_http", "tika"] },
                  "endpoint": { "type": "string" },
                  "method": { "type": "string" },
                  "version": { "type": "string" },
                  "timeout": { "type": "string" },
                  "priority": { "type": "integer" },
                  "mime_types": { "type": "array", "items": { "type": "string" } },
                  "file_classes": { "type": "array", "items": { "enum": ["text", "image", "pdf", "office_document", "office_spreadsheet", "office_presentation", "audio", "video", "archive", "unknown"] } },
                  "artifacts": { "type": "array", "items": { "enum": ["text", "metadata", "ocr_text", "layout", "table", "form", "chunk", "image_caption", "image_metadata", "embedding", "raw"] } },
                  "capabilities": { "type": "array", "items": { "enum": ["detect", "text_extract", "metadata", "ocr", "layout", "table_extract", "form_extract", "image_caption", "chunk", "embed"] } },
                  "profiles": { "type": "array", "items": { "enum": ["fast", "balanced", "quality"] } },
                  "headers": { "type": "object", "additionalProperties": { "type": "string" } },
                  "ocr": { "type": "boolean" }
                }
              }
            }
          }
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "reload_interval_seconds": { "type": "integer", "minimum": 0 },
        "fail_on_missing": { "type": "boolean" }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "metrics": { "type": "object" },
        "logging": { "type": "object" },
        "traces": { "type": "object" },
        "audit": { "type": "object" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "api_key": { "type": "string" },
            "access_key_id": { "type": "string" },
            "access_key_secret": { "type": "string" },
            "session_token": { "type": "string" },
            "app_id": { "type": "string" },
            "speech_api_key": { "type": "string" },
            "speech_access_token": { "type": "string" },
            "secret_key": { "type": "string" },
            "project_name": { "type": "string" },
            "project_id": { "type": "string" },
            "location": { "type": "string" }
          }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "base_url": { "type": "string" },
            "control_base_url": { "type": "string" },
            "timeout": { "$ref": "#/$defs/duration" },
            "retry": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "max_attempts": { "type": "integer", "minimum": 0 },
                "backoff": { "type": "string" },
                "initial_delay": { "$ref": "#/$defs/duration" }
              }
            }
          }
        },
        "models": { "$ref": "#/$defs/providerModels" }
      }
    },
    "providerModels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "overrides": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/modelOverride" }
        }
      }
    },
    "modelOverride": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "modality": {
          "enum": ["chat", "embed", "image", "video", "voice", "audio", "music", "notes", "podcast", "translation", "interpreting", "files", "batch"]
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "context_window": { "type": "integer", "minimum": 0 },
        "max_output_tokens": { "type": "integer", "minimum": 0 },
        "output_formats": { "type": "array", "items": { "type": "string" } },
        "voices": { "type": "array", "items": { "type": "string" } },
        "formats": { "type": "array", "items": { "type": "string" } },
        "session_ttl": { "$ref": "#/$defs/duration" }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fallbacks": { "type": "array" },
        "aliases": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "selectors": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
